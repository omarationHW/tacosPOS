# ============================================================
# Print Agent · configuración
# Copia este archivo a .env y llena los valores reales.
#   cp .env.example .env
# ============================================================

# --- Supabase ---
SUPABASE_URL=https://tu-proyecto.supabase.co
# Usa la SERVICE ROLE key (proceso local de confianza; evita problemas de RLS).
SUPABASE_SERVICE_KEY=tu-service-role-key

# --- Impresora (ANJET80 por red) ---
# IP de la impresora en la red de la taquería (self-test o barrido).
PRINTER_IP=192.168.1.23
PRINTER_PORT=9100

# --- Ticket ---
RESTAURANT_NAME=La Andaluza

# --- Opcionales ---
# Si esta impresora es solo para una línea (hamburguesas/carnitas),
# pon aquí su business_line_id (UUID). Vacío = imprime todas.
# BUSINESS_LINE_ID=
# Debounce para agrupar item+modificadores antes de imprimir (ms).
# PRINT_DEBOUNCE_MS=1200
